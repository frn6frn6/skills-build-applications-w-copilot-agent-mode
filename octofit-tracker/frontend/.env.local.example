# Vite environment variables for OctoFit Frontend
#
# VITE_CODESPACE_NAME: Your GitHub Codespace name (required for Codespaces forwarding)
#   Get this from your Codespace URL or the CODESPACE_NAME env var
#   Example: my-codespace-abc123
#
# VITE_API_PROTOCOL: Protocol for local development (http or https)
#   Default: http
#
# VITE_API_HOST: Hostname for local development
#   Default: localhost:8000
#
# Copy this file to .env.local and fill in your values:
# cp .env.local.example .env.local

VITE_CODESPACE_NAME=
VITE_API_PROTOCOL=http
VITE_API_HOST=localhost:8000
